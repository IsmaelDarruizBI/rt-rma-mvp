{
  "name": "rt-rma-app",
  "version": "0.1.0",
  "private": true,
  "description": "Rosario Tecno RMA App - business process discovery and modeling",
  "type": "module",
  "scripts": {
    "generate:mermaid": "tsx scripts/generate-mermaid.ts",
    "generate:viewer": "tsx scripts/generate-process-viewer.ts",
    "generate": "npm run validate && npm run generate:mermaid && npm run generate:viewer",
    "validate:process": "tsx scripts/validate-process.ts",
    "validate:features": "tsx scripts/validate-features.ts",
    "validate:references": "tsx scripts/validate-references.ts",
    "validate": "npm run validate:process && npm run validate:features && npm run validate:references",
    "validate:process:v1.3": "tsx scripts/validate-process.ts business/processes/repair-management-v1.3.yaml",
    "validate:features:v1.3": "tsx scripts/validate-features.ts business/features/repair-management-features-v1.3.yaml",
    "validate:references:v1.3": "tsx scripts/validate-references.ts business/processes/repair-management-v1.3.yaml business/rules/business-rules-v1.3.yaml business/actors/actors.yaml business/features/repair-management-features-v1.3.yaml",
    "validate:scenarios:v1.3": "tsx scripts/validate-scenarios.ts business/scenarios/repair-management-scenarios-v1.3.yaml business/processes/repair-management-v1.3.yaml business/features/repair-management-features-v1.3.yaml",
    "test:feature-scenario-mapping": "tsx scripts/test-feature-scenario-mapping.ts",
    "test:scenarios": "tsx scripts/test-scenarios.ts",
    "test:scenario-discovery": "tsx scripts/test-discover-scenario-candidates.ts",
    "discover:scenarios:v1.3": "tsx scripts/discover-scenario-candidates.ts business/processes/repair-management-v1.3.yaml business/scenarios/repair-management-scenarios-v1.3.yaml generated/scenarios/repair-management-candidates-v1.3.yaml",
    "validate:v1.3": "npm run validate:process:v1.3 && npm run validate:features:v1.3 && npm run validate:references:v1.3 && npm run validate:scenarios:v1.3 && npm run test:feature-scenario-mapping && npm run test:scenarios && npm run test:scenario-discovery",
    "generate:mermaid:v1.3": "tsx scripts/generate-mermaid.ts business/processes/repair-management-v1.3.yaml",
    "generate:viewer:v1.3": "tsx scripts/generate-process-viewer.ts business/processes/repair-management-v1.3.yaml business/rules/business-rules-v1.3.yaml business/actors/actors.yaml business/features/repair-management-features-v1.3.yaml business/scenarios/repair-management-scenarios-v1.3.yaml",
    "generate:v1.3": "npm run validate:v1.3 && npm run generate:mermaid:v1.3 && npm run generate:viewer:v1.3",
    "validate:process:v1.4": "tsx scripts/validate-process.ts business/processes/repair-management-v1.4.yaml",
    "validate:features:v1.4": "tsx scripts/validate-features.ts business/features/repair-management-features-v1.4.yaml",
    "validate:references:v1.4": "tsx scripts/validate-references.ts business/processes/repair-management-v1.4.yaml business/rules/business-rules-v1.4.yaml business/actors/actors.yaml business/features/repair-management-features-v1.4.yaml",
    "validate:scenarios:v1.4": "tsx scripts/validate-scenarios.ts business/scenarios/repair-management-scenarios-v1.4.yaml business/processes/repair-management-v1.4.yaml business/features/repair-management-features-v1.4.yaml",
    "test:feature-scenario-mapping:v1.4": "tsx scripts/test-feature-scenario-mapping.ts v1.4",
    "test:scenarios:v1.4": "tsx scripts/test-scenarios.ts v1.4",
    "test:commercial-closure:v1.4": "tsx scripts/test-commercial-closure.ts",
    "test:customer-decision:v1.4": "tsx scripts/test-customer-decision.ts",
    "test:end-events": "tsx scripts/test-end-events.ts",
    "validate:v1.4": "npm run validate:process:v1.4 && npm run validate:features:v1.4 && npm run validate:references:v1.4 && npm run validate:scenarios:v1.4 && npm run test:feature-scenario-mapping:v1.4 && npm run test:scenarios:v1.4 && npm run test:commercial-closure:v1.4 && npm run test:customer-decision:v1.4 && npm run test:end-events",
    "generate:mermaid:v1.4": "tsx scripts/generate-mermaid.ts business/processes/repair-management-v1.4.yaml",
    "generate:viewer:v1.4": "tsx scripts/generate-process-viewer.ts business/processes/repair-management-v1.4.yaml business/rules/business-rules-v1.4.yaml business/actors/actors.yaml business/features/repair-management-features-v1.4.yaml business/scenarios/repair-management-scenarios-v1.4.yaml",
    "generate:mermaid:cliente-externo:v1.4": "tsx scripts/generate-mermaid.ts business/processes/repair-management-v1.4.yaml --origin=CLIENTE_EXTERNO --scenarios=business/scenarios/repair-management-scenarios-v1.4.yaml",
    "generate:viewer:cliente-externo:v1.4": "tsx scripts/generate-process-viewer.ts business/processes/repair-management-v1.4.yaml business/rules/business-rules-v1.4.yaml business/actors/actors.yaml business/features/repair-management-features-v1.4.yaml business/scenarios/repair-management-scenarios-v1.4.yaml --origin=CLIENTE_EXTERNO",
    "generate:v1.4": "npm run validate:v1.4 && npm run generate:mermaid:v1.4 && npm run generate:viewer:v1.4 && npm run generate:mermaid:cliente-externo:v1.4 && npm run generate:viewer:cliente-externo:v1.4",
    "verify:functional-copy": "node scripts/verify-functional-copy.mjs .",
    "verify:functional-copy:source": "node scripts/verify-functional-copy.mjs . --source-repo ../rt-rma-app --expect-commit 708d81b0dab03605c70e5264e2662093126496b9",
    "validate:discrepancies": "tsx scripts/validate-baseline-discrepancies.ts",
    "validate:traceability:files": "tsx scripts/validate-traceability-files.ts",
    "validate:traceability:global": "tsx scripts/validate-traceability-global.ts",
    "test:traceability:global": "tsx scripts/test-traceability-global.ts",
    "validate:traceability": "npm run validate:traceability:files && npm run test:traceability:global && npm run validate:traceability:global",
    "validate:all": "npm run verify:functional-copy && npm run validate:discrepancies && npm run validate:v1.4 && npm run validate:v1.3 && npm run validate:traceability"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "ajv": "^8.17.1",
    "mermaid": "10.9.8",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "yaml": "^2.6.0"
  }
}
