# URL base del backend FastAPI para desarrollo local.
VITE_API_BASE_URL=http://localhost:8000

# Acceso. Sin valores, `npm run dev` usa el acceso de prueba (demo). Un build
# de produccion (UAT) exige supabase. Solo la clave PUBLICABLE de Supabase:
# nunca una clave secreta ni service_role. Ver docs/autenticacion.md.
# VITE_AUTH_MODO=supabase
# VITE_SUPABASE_URL=https://<proyecto>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Opcional: dominio de las identidades internas de los usuarios (sin correo real).
# VITE_AUTH_DOMINIO_USUARIOS=usuarios.rma.invalid
