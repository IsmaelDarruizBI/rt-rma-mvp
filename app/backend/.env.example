# Copiar como app/backend/.env (ignorado por git) y completar.
# El backend lee las variables con prefijo RMA_ desde app/backend.

# Datos de conexion para uso local: el backend no lee estas variables.
# Para usar PostgreSQL define RMA_PERSISTENCIA=postgres y RMA_DATABASE_URL.
RMA_DB_HOST=localhost
RMA_DB_PORT=5432
RMA_DB_NAME=rt_rma
RMA_DB_USER=
RMA_DB_PASSWORD=
