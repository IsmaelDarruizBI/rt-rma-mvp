{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rosariotecno.local/schemas/process.schema.json",
  "title": "Business Process",
  "description": "Contrato de validacion para procesos de negocio definidos en YAML. YAML es la fuente de verdad; este schema solo valida su forma.",
  "type": "object",
  "required": ["process", "nodes", "edges"],
  "additionalProperties": true,
  "properties": {
    "process": {
      "type": "object",
      "required": ["id", "name", "version"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/definitions/edge" }
    }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "type", "name"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["start", "end", "activity", "decision", "event"]
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "actor": {
          "type": "string",
          "description": "Conceptualmente requerido para nodos de tipo activity, aunque el schema no lo obliga todavia."
        },
        "actores_alternativos": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Otros actores igualmente autorizados a ejecutar este nodo, ademas del declarado en 'actor'. Opcional y retrocompatible: un nodo sin este campo admite unicamente su 'actor'. No establece jerarquia: 'actor' es el actor historico/principal y estos son alternativas equivalentes. Son los responsables PREDETERMINADOS: el permiso efectivo es configurable desde Administracion (BR-REP-039)."
        },
        "inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": {
          "type": "array",
          "items": { "type": "string" }
        },
        "systems": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": true,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "condition": { "type": "string" }
      }
    }
  }
}
